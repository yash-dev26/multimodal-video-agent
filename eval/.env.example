# Same keys as multimodal_agent/.env.example + video_mcp_server/.env.example
# -- eval needs both since targets.py imports components from each package.
GROQ_API_KEY=
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# Host-side equivalents of the Docker-internal values in docker-compose.yml.
# config.py already defaults to these when IN_DOCKER isn't set, so these
# lines are just here for visibility -- override only if your local
# ports/paths differ.
# MCP_SERVER=http://localhost:9090/mcp
# CHECKPOINTER_DB_URL=postgresql://multimodal_agent:multimodal_agent@localhost:5432/multimodal_agent
